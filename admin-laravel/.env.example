APP_NAME="Chatbot Hub"
APP_ENV=local
APP_KEY=base64:27cmmFvFMkmT3EuwUSu05tMlLGbU+9hMRmidfpTioOU=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# SQLite is the zero-config default so a fresh clone runs with no database
# server. The knowledge base works on it, but vector search is a brute-force
# scan rather than an index.
DB_CONNECTION=sqlite

# PostgreSQL with pgvector. Preferred once a server is available: the engine
# shares this database, and the same name must appear in the engine's
# DATABASE_URL. Requires `CREATE EXTENSION vector` in the target database.
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=chatbot_hub
# DB_USERNAME=postgres
# DB_PASSWORD=postgres

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# The FastAPI streaming engine.
ENGINE_BASE_URL=http://localhost:8000

# Shared secret for the engine's admin-plane routes (indexing, search, settings
# tests). Generate one per install and set the same value as ADMIN_API_TOKEN in
# the engine's environment. The engine refuses those routes without it.
ENGINE_ADMIN_TOKEN=
