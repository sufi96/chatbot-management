# Settings for the Spark Compose files. Copy this file to deploy/sparks/.env on
# each node and fill it in. The copy holds a secret and is never committed.
#
# Nothing below could be tried before the hardware existed. Image tags and model
# repositories are examples taken from docs/model-stack-review.md; confirm each
# one exists, fits, and runs on the Spark before the first pull.

# ---------------------------------------------------------------------------
# Shared by both nodes
# ---------------------------------------------------------------------------

# A vLLM image built for the Spark: arm64, with a CUDA new enough for its
# Blackwell GPU. NVIDIA's NGC vLLM container is built for it; check
# catalog.ngc.nvidia.com for the newest tag that lists DGX Spark support.
VLLM_IMAGE=nvcr.io/nvidia/vllm:26.08-py3

# Where model weights are cached, on the node's own NVMe drive.
MODEL_CACHE=/srv/models

# A Hugging Face token, needed only for gated models.
HF_TOKEN=

# The key every client must send. Put the same value in the portal: the AI
# provider row for node A, and Admin Settings > Models for node B.
# Generate one with:  openssl rand -hex 32
VLLM_API_KEY=change-me-before-first-start

# ---------------------------------------------------------------------------
# Node A: the answer model
# ---------------------------------------------------------------------------

# It has to be an NVFP4 or FP8 checkpoint. Full-precision 122B weights are about
# 244 GB and do not fit in 128 GB. This repository name is a placeholder to
# replace with a real quantised checkpoint.
ANSWER_MODEL=example-org/Qwen3.5-122B-A10B-NVFP4
# The name the portal's bot "Model" field must match.
ANSWER_SERVED_NAME=qwen3.5-122b-a10b
ANSWER_MAX_MODEL_LEN=32768
ANSWER_EXTRA_ARGS=--reasoning-parser qwen3

# ---------------------------------------------------------------------------
# Node B: everything else
# ---------------------------------------------------------------------------

# Intent and SQL. Admin Settings > Models > Intent and SQL both point here.
INTENT_SQL_MODEL=Qwen/Qwen3.5-35B-A3B-FP8
INTENT_SQL_SERVED_NAME=qwen3.5-35b-a3b
INTENT_SQL_EXTRA_ARGS=

# Embedding. Set Admin Settings > Embedding > Dimensions to 1024 and rebuild the
# index after switching: the engine asks for that many and refuses any other.
# Qwen3-Embedding is served for pooling rather than generation. The flag has
# changed between vLLM versions (--task embed, later --runner pooling); check
# `vllm serve --help` inside the image.
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
EMBEDDING_SERVED_NAME=qwen3-embedding-4b
EMBEDDING_EXTRA_ARGS=--runner pooling

# Reranker. bge-reranker-v2-m3 is a cross-encoder vLLM recognises as one without
# extra flags, and it is the model already tested with this install.
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_SERVED_NAME=bge-reranker-v2-m3
RERANK_EXTRA_ARGS=

# Guard.
GUARD_MODEL=Qwen/Qwen3Guard-Gen-4B
GUARD_SERVED_NAME=qwen3guard-gen-4b
GUARD_EXTRA_ARGS=

# Vision, for scanned documents. An FP8 checkpoint, so it fits its 0.15 share.
VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct-FP8
VISION_SERVED_NAME=qwen3-vl-8b
VISION_EXTRA_ARGS=--max-model-len 16384
