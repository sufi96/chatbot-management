    {
      "type": "text",
      "id": "ev2_t",
      "x": 110,
      "y": 2075,
      "width": 770,
      "height": 200,
      "text": "def should_retrieve(message):\n    if not message.strip():        return False\n    if \"?\" in message:             return True     # always wins\n    words = re.findall(r\"[a-z]+\", message.lower())\n    if all(w in SMALLTALK for w in words):  return False\n    return any(len(w) > 2 for w in words)",
      "originalText": "def should_retrieve(message):\n    if not message.strip():        return False\n    if \"?\" in message:             return True     # always wins\n    words = re.findall(r\"[a-z]+\", message.lower())\n    if all(w in SMALLTALK for w in words):  return False\n    return any(len(w) > 2 for w in words)",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#22c55e",
      "backgroundColor": "transparent",
