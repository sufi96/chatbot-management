    {
      "type": "text",
      "id": "ev3_t",
      "x": 990,
      "y": 2075,
      "width": 510,
      "height": 200,
      "text": "score(chunk) =  sum over branches of\n\n                    1\n              ----------------\n               60 + rank\n\nrank, never the raw similarity",
      "originalText": "score(chunk) =  sum over branches of\n\n                    1\n              ----------------\n               60 + rank\n\nrank, never the raw similarity",
      "fontSize": 15,
      "fontFamily": 3,
